{
  "name": "dsh-glass-skin",
  "version": "1.4.0",
  "description": "Acrylic / frosted-glass appearance for DeepSeek Harness: translucent UI over the native Windows window material, layered on top of any active theme.",
  "license": "MIT",
  "type": "module",
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-glass-skin": "scripts/install.mjs"
  },
  "files": [
    "plugin/index.js",
    "plugin/fs-raw.js",
    "plugin/client.js",
    "plugin/cordis.patch.yml",
    "plugin/locale/*.json",
    "plugin/icon.svg",
    "tools/dsh-glass-desktop.mjs",
    "tools/repair.mjs",
    "tools/doctor.mjs",
    "tools/launch.mjs",
    "scripts/install.mjs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "install-glass": "node scripts/install.mjs",
    "uninstall": "node scripts/install.mjs --uninstall",
    "dry-run": "node scripts/install.mjs --dry-run",
    "test": "node tools/glass-client-contract.test.mjs && node tools/glass-row-render.test.mjs && node tools/glass-render.test.mjs",
    "repair": "node tools/repair.mjs",
    "doctor": "node tools/doctor.mjs",
    "launch": "node tools/launch.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "glass",
    "acrylic",
    "mica",
    "frosted-glass",
    "windows"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InkStain258/dsh-glass-skin.git"
  },
  "bugs": {
    "url": "https://github.com/InkStain258/dsh-glass-skin/issues"
  },
  "homepage": "https://github.com/InkStain258/dsh-glass-skin#readme"
}
